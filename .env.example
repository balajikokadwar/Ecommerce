# Copy this file to ".env" for local runs. Never commit the real ".env" file.
# In CI/CD (e.g. GitHub Actions), set these as repository/environment secrets
# and export them as environment variables instead of using a .env file.

LOGIN_EMAIL=your_email@example.com
LOGIN_PASSWORD=your_password

# Optional overrides of config/config.yaml (uncomment to use)
